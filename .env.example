# Copy to .env and fill in to use a hosted Turso database.
# With these unset, the app uses a local SQLite file (database.db) and needs
# no external services.

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: local path for Turso's embedded replica (used in production)
# TURSO_REPLICA_PATH=

# Optional: path to the local SQLite file (defaults to database.db)
# ADVENTURE_DB_PATH=
